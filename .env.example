# --- LLM: any OpenAI-compatible /chat/completions endpoint with tool calling ---
# OpenRouter:  API_BASE_URL=https://openrouter.ai/api/v1        MODEL=anthropic/claude-sonnet-4.5
# Nous Portal: API_BASE_URL=https://inference-api.nousresearch.com/v1   MODEL=<model id from the portal>
# OpenAI:      API_BASE_URL=https://api.openai.com/v1           MODEL=gpt-4.1
# Anthropic:   API_BASE_URL=https://api.anthropic.com/v1/       MODEL=claude-sonnet-4-5
API_BASE_URL=https://openrouter.ai/api/v1
API_KEY=sk-...
MODEL=anthropic/claude-sonnet-4.5

# --- Telegram (optional: leave TELEGRAM_BOT_TOKEN empty to use only the web + CLI) ---
TELEGRAM_BOT_TOKEN=
# Your numeric user id (ask @userinfobot). Messages from anyone else are ignored.
ALLOWED_USER_ID=

# --- Web dashboard ---
WEB_ENABLED=true
WEB_HOST=127.0.0.1            # keep 127.0.0.1; use an SSH tunnel for remote access (see README)
WEB_PORT=8765
# Login token. Leave empty to auto-generate one (show it with: python cli.py url)
WEB_TOKEN=

# --- Agent ---
# Directory the agent works in. Shell, file tools and approvals are scoped to it.
WORKDIR=~/agent-work
GOAL_INTERVAL=30              # minutes between standing-goal cycles when the queue is empty
MAX_STEPS_PER_TASK=40         # tool calls per task
DAILY_TOKEN_BUDGET=2000000    # prompt+completion tokens per UTC day; worker pauses when hit
# ACCESS=workdir keeps the agent inside WORKDIR. ACCESS=full lets it read/write anywhere
# this user can (and use sudo if you allow it, see README). Risky commands still need
# approval unless APPROVALS=off.
ACCESS=workdir
APPROVALS=on
# Every N tool steps the agent writes one plain-language recap line (🧭). 0 turns it off.
PROGRESS_EVERY=5

# --- Multi-agent ---
# The lead agent can spawn helper agents and ask a review agent. All of them share the
# same token budget, approvals and /stop, and show up in the dashboard's Agents panel.
MAX_WORKERS=3          # max helper agents the lead may run at once (0 disables delegation)
WORKER_MAX_STEPS=25    # tool-call cap per helper agent
REVIEW=on              # auto-review each completed task with the review agent (off to disable)
REVIEW_MAX_STEPS=15    # tool-call cap for the review agent

# --- Relay (optional: reach the agent from a phone app, with NO open port) ---
# The agent dials OUT to a public relay you run (see relay/). Leave empty to disable.
# RELAY_URL=wss://your-relay.example/ws/agent
# RELAY_AGENT_KEY=the-same-secret-as-the-relays-RELAY_AGENT_KEY
DEFAULT_VERBOSE=steps         # off | steps | full for Telegram + CLI (the web feed shows everything)

# Optional: price per 1M tokens (USD) for the /status cost estimate.
# If the provider reports cost itself (OpenRouter does), that is used instead.
PRICE_INPUT_PER_M=3
PRICE_OUTPUT_PER_M=15

# Optional tuning
APPROVAL_TIMEOUT=900          # seconds to wait for Approve/Deny before auto-deny
SHELL_TIMEOUT=120             # default shell() timeout in seconds (model may ask up to 1800)
LLM_TIMEOUT=180               # seconds per LLM request
# DB_PATH=data/agent.db
# LOG_DIR=logs
